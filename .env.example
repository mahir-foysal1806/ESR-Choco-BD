# Copy to .env and replace every placeholder before deploying.
APP_PORT=5000
# Optional: set this to a managed MongoDB URI instead of the bundled MongoDB container.
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/cocoa_crunch
NODE_ENV=production
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES=7d
CLIENT_URL=https://your-domain.com
SITE_URL=https://your-domain.com
ADMIN_NAME=Store Owner
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Cloudinary: uploaded images persist independently of the Docker container.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=cocoa-crunch

# Configure payment/SMS credentials only when those gateways are enabled.
SMS_PROVIDER=log
SMS_API_KEY=
SMS_SENDER_ID=
SMS_API_URL=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASS=
SSLCOMMERZ_SANDBOX=true
API_PUBLIC_URL=https://your-domain.com
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=
NAGAD_MERCHANT_ID=
NAGAD_PUBLIC_KEY=
NAGAD_PRIVATE_KEY=
NAGAD_BASE_URL=
